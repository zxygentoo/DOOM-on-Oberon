# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "DOOM as an Oberon command on Wirth's RISC5 machine, via an all-OCaml C toolchain"
description: """
A goblint-cil front end and a RISC5 backend compile doomgeneric into a flat
blob that a small Oberon-07 stub loads into himem and runs, on the emulator,
the cycle-accurate Hardcaml model and a Nexys 4 FPGA."""
maintainer: ["zxy <zxygentoo@gmail.com>"]
authors: ["zxy <zxygentoo@gmail.com>"]
license: "MIT AND GPL-2.0-or-later"
homepage: "https://github.com/zxygentoo/DOOM-on-Oberon"
bug-reports: "https://github.com/zxygentoo/DOOM-on-Oberon/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.3"}
  "goblint-cil" {= "2.1.0"}
  "crunch"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/zxygentoo/DOOM-on-Oberon.git"
