; runner: the jig's execution half (one compiled function in the emulator)
; test_runner: the runner's own plumbing, on hand-built instructions
; test_jig: the differential jig — C samples compiled by doomcc_core and by host gcc
; test_blob: the blob envelope, loaded and run the way the stub does
; test_wadsplit: Wad's chunking invariants

(tests
 (names test_runner test_jig test_blob test_wadsplit)
 (libraries emu doomcc_core unix)
 ; the jig reads libc/*.c at run time: declaring them puts them in the runtest
 ; sandbox and re-runs the jig when they change
 (deps
  (glob_files %{workspace_root}/libc/*.c)))
