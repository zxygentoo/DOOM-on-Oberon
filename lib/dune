; abi_constants: the ABI.md constants, dependency-free so the emulator harnesses
; use them without the compiler

(library
 (name abi_constants)
 (modules abi_constants))

; run_harness: plumbing shared by bin/run_blob and bin/run_dsk

(library
 (name run_harness)
 (modules run_harness)
 (libraries emu))

; doomcc_core: the compiler — CIL front end, codegen, linker, blob envelope

(library
 (name doomcc_core)
 (modules :standard \ abi_constants run_harness)
 (libraries goblint-cil emu abi_constants))
