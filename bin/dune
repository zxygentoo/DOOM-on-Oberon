; doomcc — the whole-program driver (AGENT.md 1b): preprocessed C (.i) -> RISC5 blob.
; The full pipeline: front (parse + amalgamate), per-function codegen, the instr-level
; linker + crt0 thunks, and the ABI §7 blob file + symbol map. See bin/doomcc.ml.

(executable
 (name doomcc)
 (libraries doomcc_core goblint-cil emu))

; wadsplit — host-side WAD chunk splitter (AGENT.md §3): DOOM1.WAD -> <=3 MiB
; byte-range chunk files the PO filesystem can hold; the stub concatenates them
; into himem at init. See bin/wadsplit.ml.

(executable
 (name wadsplit)
 (libraries doomcc_core))

; doomrun — the 1d emulator harness: doom.blob + doom1.wad -> himem, the SHARED
; page, a UART console, and the Init/Tick loop with PGM frame dumps. The stub's
; role, played host-side. See bin/doomrun.ml.

(executable
 (name doomrun)
 (libraries emu))

; bn64 — void-and-cluster blue-noise threshold-map generator (host tooling):
; emits
; the __dg_bn64 table baked into libc/dither.c. Deterministic; see the file.

(executable
 (name bn64))

; doomboot — the Cyclesim boot ROM stub (1d sim leg): ~30 eDSL words that call
; the blob's crt0 entries and report progress via the SHARED page. The third
; artifact crossing the sim seam, next to doom.blob and doom1.wad.

(executable
 (name doomboot)
 (libraries doomcc_core emu))

; dskrun — boot a .dsk in-process and drive the booted system with a scripted
; timeline: raw PS/2 bytes, middle-clicks, ABI par-8 SHARED probes, PGM dumps.
; The on-system complement of doomrun's -keys. See bin/dskrun.ml.

(executable
 (name dskrun)
 (libraries emu))
