; doomcc: preprocessed C -> doom.blob and its symbol map

(executable
 (name doomcc)
 (modules doomcc)
 (libraries doomcc_core abi_constants goblint-cil emu))

; split_wad: the WAD -> chunk files the PO filesystem can hold

(executable
 (name split_wad)
 (modules split_wad)
 (libraries doomcc_core))

; run_blob: the blob on the emulator, loaded as DOOM.Mod loads it

(executable
 (name run_blob)
 (modules run_blob)
 (libraries emu abi_constants run_harness))

; emit_bn64: the blue-noise threshold table in libc/dither.c

(executable
 (name emit_bn64)
 (modules emit_bn64))

; emit_rom: the boot ROM run_sim boots

(executable
 (name emit_rom)
 (modules emit_rom)
 (libraries doomcc_core abi_constants emu))

; run_dsk: boot a .dsk on the emulator and drive it from a script

(executable
 (name run_dsk)
 (modules run_dsk)
 (libraries emu abi_constants run_harness))
