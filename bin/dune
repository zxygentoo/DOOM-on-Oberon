; doomcc — the whole-program driver (AGENT.md 1b): preprocessed C (.i) -> RISC5 blob.
; The full pipeline: front (parse + amalgamate), per-function codegen, the instr-level
; linker + crt0 thunks, and the ABI §7 blob file + symbol map. See bin/doomcc.ml.

(executable
 (name doomcc)
 (modules doomcc)
 (libraries doomcc_core abi_constants goblint-cil emu))

; split_wad — host-side WAD chunk splitter (AGENT.md §3): DOOM1.WAD -> <=3 MiB
; byte-range chunk files the PO filesystem can hold; the stub concatenates them
; into himem at init. See bin/split_wad.ml.

(executable
 (name split_wad)
 (modules split_wad)
 (libraries doomcc_core))

; run_blob — the 1d emulator harness: doom.blob + doom1.wad -> himem, the SHARED
; page, a UART console, and the Init/Tick loop with PGM frame dumps. The stub's
; role, played host-side. See bin/run_blob.ml.

(executable
 (name run_blob)
 (modules run_blob)
 (libraries emu abi_constants run_harness))

; emit_bn64 — void-and-cluster blue-noise threshold-map generator (host tooling):
; emits
; the __dg_bn64 table baked into libc/dither.c. Deterministic; see the file.

(executable
 (name emit_bn64)
 (modules emit_bn64))

; emit_rom — the Cyclesim boot ROM stub (1d sim leg): ~30 eDSL words that call
; the blob's crt0 entries and report progress via the SHARED page. The third
; artifact crossing the sim seam, next to doom.blob and doom1.wad.

(executable
 (name emit_rom)
 (modules emit_rom)
 (libraries doomcc_core abi_constants emu))

; run_dsk — boot a .dsk in-process and drive the booted system with a scripted
; timeline: raw PS/2 bytes, middle-clicks, ABI par-8 SHARED probes, PGM dumps.
; The on-system complement of run_blob's -keys. See bin/run_dsk.ml.

(executable
 (name run_dsk)
 (modules run_dsk)
 (libraries emu abi_constants run_harness))
